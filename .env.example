# ─── Analytics ────────────────────────────────────────────────────────────
# Google Tag Manager container ID.
#
# Leave this UNSET locally. When it is unset, no analytics component renders,
# nothing is requested from googletagmanager.com, and the cookie banner does
# not appear — so local work never reports into the production container.
#
# Set it in your production environment only (Vercel / host dashboard).
# It is NEXT_PUBLIC_ because the browser needs it; the value is not a secret
# and appears in the page source either way.
#
# NEXT_PUBLIC_GTM_ID=GTM-NC5P255Z
